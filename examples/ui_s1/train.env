# Version-controlled UI-S1 experiment definition. Command-line environment
# variables may override any value for an explicitly recorded experiment.
DATASET="${DATASET:-android_control}"
EPOCHS="${EPOCHS:-1}"
MAX_STEPS="${MAX_STEPS:-}"
ROLLOUT_BATCH_SIZE="${ROLLOUT_BATCH_SIZE:-4}"
ACTOR_GLOBAL_BATCH_SIZE="${ACTOR_GLOBAL_BATCH_SIZE:-4}"
# GRPO needs at least two trajectories per task. Four keeps a useful
# within-task comparison while avoiding the previous eight-way default.
ROLLOUT_N="${ROLLOUT_N:-4}"
ACTOR_DYNAMIC_BATCHING="${ACTOR_DYNAMIC_BATCHING:-false}"
ACTOR_USE_TORCH_COMPILE="${ACTOR_USE_TORCH_COMPILE:-false}"
EXPERIENCE_MICRO_BATCH_SIZE="${EXPERIENCE_MICRO_BATCH_SIZE:-1}"
ACTOR_LR="${ACTOR_LR:-1.0e-6}"
# Keep native vLLM level-1 sleep enabled: it offloads model weights between
# rollout and actor update. Set false only as an emergency fallback if the
# local CUDA stack still fails inside CuMem sleep.
VLLM_ENABLE_SLEEP_MODE="${VLLM_ENABLE_SLEEP_MODE:-true}"
# This server uses two independent TP=1 vLLM workers. Two distinct rollout-step
# requests therefore give both GPUs useful work in one wave. Set
# a larger value only after confirming vLLM has enough KV-cache memory; set 0
# to explicitly generate every active trajectory in one vLLM request.
GENERATION_MICRO_BATCH_SIZE="${GENERATION_MICRO_BATCH_SIZE:-2}"
# Bound diversity retries. It must remain at least ROLLOUT_N.
MAX_ROLLOUTS_PER_TASK="${MAX_ROLLOUTS_PER_TASK:-8}"
# Refill a failed task in a four-rollout batch, then select the most diverse
# ROLLOUT_N trajectories from the enlarged pool. This avoids serial
# one-rollout diversity retries.
DIVERSITY_REFILL_BATCH_SIZE="${DIVERSITY_REFILL_BATCH_SIZE:-4}"
# Poll nvidia-smi at this interval and update gpu_memory_peak.json in the run
# directory. It records device-level high-water marks across all phases.
GPU_MEMORY_MONITOR_INTERVAL_SECONDS="${GPU_MEMORY_MONITOR_INTERVAL_SECONDS:-1}"
# Emit one concise VALIDATION | PROGRESS line for every N validation batches.
VALIDATION_PROGRESS_INTERVAL="${VALIDATION_PROGRESS_INTERVAL:-25}"
HISTORY_IMAGE_LIMIT="${HISTORY_IMAGE_LIMIT:-2}"
MAX_PROMPT_LENGTH="${MAX_PROMPT_LENGTH:-12288}"
MAX_RESPONSE_LENGTH="${MAX_RESPONSE_LENGTH:-512}"
MAX_IMAGE_PIXELS="${MAX_IMAGE_PIXELS:-2097152}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-12800}"
VLLM_MAX_NUM_BATCHED_TOKENS="${VLLM_MAX_NUM_BATCHED_TOKENS:-24576}"
LORA_TARGET_MODULES="${LORA_TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj}"
PATCH_THRESHOLD="${PATCH_THRESHOLD:-1}"
# Auxiliary expert-action imitation is opt-in so PATCH_IMITATION_ENABLED=false
# remains a strict GRPO-only ablation. Enabling it requires an explicitly
# selected positive initial objective weight; 0.0 is only the disabled sentinel.
PATCH_IMITATION_ENABLED="${PATCH_IMITATION_ENABLED:-false}"
PATCH_IMITATION_LAMBDA_INITIAL="${PATCH_IMITATION_LAMBDA_INITIAL:-0.0}"
PATCH_IMITATION_LAMBDA_DECAY="${PATCH_IMITATION_LAMBDA_DECAY:-1.0}"
PATCH_IMITATION_LAMBDA_MIN="${PATCH_IMITATION_LAMBDA_MIN:-0.0}"
# These mode switches reserve the future thinking-supervision path. The
# current implementation deliberately accepts only the two values below.
PATCH_IMITATION_TARGET_MODE="${PATCH_IMITATION_TARGET_MODE:-action_only}"
PATCH_HISTORY_MODE="${PATCH_HISTORY_MODE:-keep_model_thinking}"
UIS1_GAMMA="${UIS1_GAMMA:-0.5}"
UIS1_STEP_ADVANTAGE_WEIGHT="${UIS1_STEP_ADVANTAGE_WEIGHT:-1.0}"
UIS1_EPISODE_ADVANTAGE_WEIGHT="${UIS1_EPISODE_ADVANTAGE_WEIGHT:-1.0}"
UIS1_ADVANTAGE_STD_THRESHOLD="${UIS1_ADVANTAGE_STD_THRESHOLD:-0.3}"
SAVE_EVERY_N_EPOCHS="${SAVE_EVERY_N_EPOCHS:-1}"
# Save the latest completed actor update after this many seconds. Set a
# positive value such as 1800 for a 30-minute checkpoint cadence; 0 disables
# time-based checkpoints and keeps the epoch-based behavior above.
SAVE_INTERVAL_SECONDS="${SAVE_INTERVAL_SECONDS:-0}"
# Keep every periodic checkpoint by default. Set a positive value to retain
# only that many recent checkpoints (the best validation checkpoint is kept).
SAVE_LIMIT="${SAVE_LIMIT:--1}"
# Reuse RUN_NAME and automatically restore its latest complete checkpoint.
# Set RESUME=true only for an existing run directory with a checkpoint tracker.
RESUME="${RESUME:-false}"
RESUME_CHECKPOINT_PATH="${RESUME_CHECKPOINT_PATH:-}"
# LoRA-only warm start from an existing complete global_step_<N> checkpoint.
# It is mutually exclusive with RESUME=true and always requires a new RUN_NAME.
# ``inherit`` restores the source StatefulDataLoader cursor; ``reset`` starts
# the requested data order from the beginning while retaining the LoRA weights.
WARM_START_CHECKPOINT_PATH="${WARM_START_CHECKPOINT_PATH:-}"
WARM_START_DATALOADER="${WARM_START_DATALOADER:-inherit}"
